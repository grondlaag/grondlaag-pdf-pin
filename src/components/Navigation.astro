---
const grondlaagBaseUrl = 'https://grondlaag.github.io/grondlaag';
const links = [
	{ href: `${grondlaagBaseUrl}/`, label: 'home' },
	{ href: `${grondlaagBaseUrl}/advies`, label: 'advies' },
	{ href: `${grondlaagBaseUrl}/opleidingen`, label: 'opleidingen' },
	{ href: `${grondlaagBaseUrl}/alaambak`, label: 'alaambak' },
	{ href: `${grondlaagBaseUrl}/inzichten`, label: 'notities' },
];
---

<header class="site-nav">
	<div class="container site-nav__inner">
		<a class="site-nav__brand" href={`${grondlaagBaseUrl}/`}>grondlaag</a>
		<nav aria-label="hoofdnavigatie">
			<ul class="site-nav__list">
				{
					links.map((link) => (
						<li>
							<a class="site-nav__link" href={link.href}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
